{
  "name": "dsh-prompt-snippets",
  "version": "1.4.0",
  "type": "module",
  "description": "Save reusable prompt snippets with categories, {{placeholder}} fill forms & dropdown enums, version history, pinned/tag search, streaming AI rewrite, and crash-safe atomic JSON storage — insert them from the composer toolbar via a floating panel.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "prompt",
    "snippet",
    "template",
    "placeholder",
    "prompting",
    "productivity",
    "ui",
    "workflow",
    "tools"
  ],
  "license": "MIT",
  "author": "dadazhangn",
  "homepage": "https://github.com/dadazhangn/dsh-prompt-snippets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadazhangn/dsh-prompt-snippets.git"
  },
  "bugs": {
    "url": "https://github.com/dadazhangn/dsh-prompt-snippets/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint index.js client.js",
    "lint:fix": "eslint index.js client.js --fix",
    "test": "node test/v110-host-test.mjs && node test/optimize-test.mjs && node test/io-test.mjs && node test/client-test.mjs && node test/client-error-test.mjs && node test/stream-client-test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "devDependencies": {
    "eslint": "^8.57.1"
  }
}
